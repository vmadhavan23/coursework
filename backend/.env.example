# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# Path to the local SQLite database file used for match/game/point data.
DATABASE_PATH=./tabletennis.db

# Astra DB (DataStax) database this backend will (best-effort) ingest completed-match
# and video-analysis summaries into, as the app's RAG knowledge index.
# Leave either value unset to disable ingestion entirely (no error, just skipped).
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=

# Used by the video-analysis feature (POST /video-analysis) to send a match
# video URL to Gemini for a best-effort, AI-estimated stats readout.
# Leave unset to disable the feature entirely (503 on the endpoint).
GEMINI_API_KEY=
